@page "/admin"
@using Apollo.Web.Client.Contracts
@using Apollo.Web.Client.Pages.Admin.Events
@using Apollo.Web.Client.Pages.Admin.Status
@implements IAsyncDisposable
@inject IBotStatusClient Client
@inject TimeProvider Time
@inject IStringLocalizer<Strings> L

@*
    Bot-Status (#31, #91, scope §7.2): the "data is being collected" proof. The bot writes a heartbeat every 30 s (#24);
    this page reads the latest one with what the database says about the recorded data, and reloads it every 30 s while
    it is open.
*@
<PageTitle>@L["PageTitle", L["Nav_BotStatus"]]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
    <div class="d-flex flex-wrap align-center justify-space-between gap-2 mb-4">
        <div>
            <MudText Typo="Typo.h1">@L["Nav_BotStatus"]</MudText>
            @if (_status is not null)
            {
                <MudText Typo="Typo.body2" Class="apollo-bot-checked mud-text-secondary">@L["BotStatus_CheckedAt", UiTime.FormatTimeWithSeconds(_status.CheckedAt)]</MudText>
            }
        </div>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Refresh" OnClick="LoadAsync" Disabled="@(_loadsRunning > 0)" Class="apollo-bot-refresh">@L["BotStatus_Refresh"]</MudButton>
    </div>

    @if (_failed)
    {
        <MudAlert Severity="Severity.Error" Class="apollo-bot-load-failed mb-4">@L["BotStatus_LoadFailed"]</MudAlert>
    }

    @if (_status is { NoTrackingRole: true })
    {
        <MudAlert Severity="Severity.Info" Class="apollo-bot-no-tracking-role mb-4">
            <strong>@L["BotStatus_NoTrackingRole_Title"]</strong> @L["BotStatus_NoTrackingRole_Text"]
            <MudLink Href="/admin/settings">@L["BotStatus_NoTrackingRole_Link"]</MudLink>
        </MudAlert>
    }

    @if (_status is null)
    {
        @if (!_failed)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
    }
    else if (_status.LastHeartbeatAt is not { } lastHeartbeatAt)
    {
        <MudPaper Elevation="0" Class="apollo-section-card">
            <EmptyState Icon="@Icons.Material.Outlined.SmartToy" Title="@L["BotStatus_NoHeartbeat_Title"]" Explanation="@L["BotStatus_NoHeartbeat_Text"]" />
        </MudPaper>
    }
    else
    {
        @if (_status.IsStale)
        {
            <MudAlert Severity="Severity.Warning" Class="apollo-bot-stale mb-4">
                <strong>@L["BotStatus_Stale_Title", UiTime.FormatSince(lastHeartbeatAt, _status.CheckedAt), L.Ago(lastHeartbeatAt, _status.CheckedAt)]</strong>
                <div>@L["BotStatus_Stale_Text"]</div>
            </MudAlert>
        }
        else if (!_status.Connected)
        {
            <MudAlert Severity="Severity.Error" Class="apollo-bot-offline mb-4">
                <strong>@L["BotStatus_Offline_Title"]</strong>
                @if (_status.LastConnectedAt is { } lastConnectedAt)
                {
                    <div>@L["BotStatus_Offline_LastConnected", UiTime.FormatSince(lastConnectedAt, _status.CheckedAt)]</div>
                }
                <div>@L["BotStatus_Offline_Text"]</div>
            </MudAlert>
        }

        <MudGrid Spacing="3">
            <MudItem xs="12" sm="6" md="3">
                <StatTile Label="@L["BotStatus_Connection"]" Icon="@Icons.Material.Outlined.Link"
                          SubText="@L["BotStatus_LastHeartbeat", UiTime.FormatTimeWithSeconds(lastHeartbeatAt)]">
                    <ValueContent>
                        <span class="apollo-bot-connection @ConnectionClass">@ConnectionText</span>
                    </ValueContent>
                </StatTile>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <StatTile Label="@L["BotStatus_Latency"]" Icon="@Icons.Material.Outlined.Speed" Value="@_status.GatewayLatencyMeanMs" Unit="@L["BotStatus_LatencyUnit"]"
                          SubText="@L["BotStatus_LatencyMean"]" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                @if (_status.LastRecordedEvent is { } lastRecorded)
                {
                    <StatTile Label="@L["BotStatus_LastEvent"]" Icon="@Icons.Material.Outlined.Bolt" SubText="@LastEventText(lastRecorded)">
                        <ValueContent>@L.Ago(lastRecorded.OccurredAt, _status.CheckedAt)</ValueContent>
                    </StatTile>
                }
                else
                {
                    <StatTile Label="@L["BotStatus_LastEvent"]" Icon="@Icons.Material.Outlined.Bolt" SubText="@L["BotStatus_NothingRecorded"]" />
                }
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <StatTile Label="@L["BotStatus_OpenVoiceSessions"]" Icon="@Icons.Material.Outlined.Headset" Value="@_status.OpenVoiceSessions.Count"
                          SubText="@VoiceChannelsText" />
            </MudItem>
            <MudItem xs="12" md="8">
                <SectionCard Title="@L["BotStatus_EventsPerHour"]">
                    <Action>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["BotStatus_Last24Hours"]</MudText>
                    </Action>
                    <ChildContent>
                        <EventsPerHourChart Hours="_status.EventsPerHour" />
                    </ChildContent>
                </SectionCard>
            </MudItem>
            <MudItem xs="12" md="4">
                <SectionCard Title="@L["BotStatus_OpenVoiceSessions"]">
                    @* Stacks into labelled rows below 600px, so nothing scrolls sideways at 360px. *@
                    <MudTable T="OpenVoiceSessionDto" Items="_status.OpenVoiceSessions" Class="apollo-bot-voice-sessions" Dense="true" Elevation="0"
                              Breakpoint="Breakpoint.Xs" RowClass="apollo-bot-voice-session">
                        <HeaderContent>
                            <MudTh>@L["BotStatus_VoiceSessions_Member"]</MudTh>
                            <MudTh>@L["BotStatus_VoiceSessions_Channel"]</MudTh>
                            <MudTh>@L["BotStatus_VoiceSessions_Since"]</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="@L["BotStatus_VoiceSessions_Member"]">@(context.MemberName ?? UiCulture.Placeholder)</MudTd>
                            <MudTd DataLabel="@L["BotStatus_VoiceSessions_Channel"]">@(context.ChannelName ?? UiCulture.Placeholder)</MudTd>
                            <MudTd DataLabel="@L["BotStatus_VoiceSessions_Since"]" Class="apollo-numeric">@UiTime.FormatSince(context.Since, _status.CheckedAt)</MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["BotStatus_VoiceSessions_Empty"]</MudText>
                        </NoRecordsContent>
                    </MudTable>
                </SectionCard>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    /// <summary>How often the page reloads the status; the bot writes a heartbeat as often (#24).</summary>
    public static readonly TimeSpan RefreshInterval = TimeSpan.FromSeconds(30);

    private readonly CancellationTokenSource _stop = new();
    private PeriodicTimer? _timer;
    private BotStatusDto? _status;
    private bool _failed;
    private int _loadsRunning;
    private int _latestLoad;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        if (_stop.IsCancellationRequested)
        {
            // Left while the first load ran: no timer to leak.
            return;
        }

        _timer = new PeriodicTimer(RefreshInterval, Time);
        _ = RefreshPeriodicallyAsync(_timer, _stop.Token);
    }

    private async Task RefreshPeriodicallyAsync(PeriodicTimer timer, CancellationToken cancellationToken)
    {
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    await LoadAsync();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested)
        {
            // The page was left.
        }
    }

    /// <summary>
    /// Loads the status. A click and a tick can overlap; only the newest load may change the page, so an older answer
    /// that arrives late is dropped. Any failure but leaving the page keeps the last status on screen and marks it
    /// failed; the next tick tries again.
    /// </summary>
    private async Task LoadAsync()
    {
        var load = ++_latestLoad;
        _loadsRunning++;
        try
        {
            var status = await Client.GetStatusAsync(_stop.Token);
            if (load == _latestLoad)
            {
                _status = status;
                _failed = false;
            }
        }
        catch (OperationCanceledException) when (_stop.IsCancellationRequested)
        {
            // The page was left.
        }
#pragma warning disable CA1031 // A timeout, an HTML answer or an empty body all mean "not loaded"; none may stop the refresh.
        catch (Exception)
#pragma warning restore CA1031
        {
            // Only the newest load decides; an older one that fails late changes nothing.
            _failed |= load == _latestLoad;
        }
        finally
        {
            _loadsRunning--;
        }
    }

    /// <summary>What the newest recorded row was, e.g. "Nachricht in #allgemein"; the type only for a row without a channel.</summary>
    private string LastEventText(LastRecordedEventDto recorded) => recorded.ChannelName is { } channel
        ? L["BotStatus_LastEvent_InChannel", DataEventText.TypeName(L, recorded.Type), channel]
        : DataEventText.TypeName(L, recorded.Type);

    /// <summary>"In 2 Kanälen"; no subtext while nobody is in voice.</summary>
    private string? VoiceChannelsText => _status!.OpenVoiceSessions.Select(s => s.ChannelId).Distinct().Count() switch
    {
        0 => null,
        1 => L["BotStatus_VoiceChannels_One"].Value,
        var channels => L["BotStatus_VoiceChannels_Many", channels].Value,
    };

    /// <summary>While the heartbeat is stale, the last reported state is only a guess.</summary>
    private string ConnectionText => (_status!.IsStale, _status.Connected) switch
    {
        (true, true) => L["BotStatus_ConnectedUnsure"],
        (true, false) => L["BotStatus_DisconnectedUnsure"],
        (false, true) => L["BotStatus_Connected"],
        (false, false) => L["BotStatus_Disconnected"],
    };

    private string ConnectionClass => _status switch
    {
        { IsStale: true } => "mud-warning-text",
        { Connected: true } => "mud-success-text",
        _ => "mud-error-text",
    };

    public async ValueTask DisposeAsync()
    {
        await _stop.CancelAsync();
        _timer?.Dispose();
        _stop.Dispose();
    }
}
