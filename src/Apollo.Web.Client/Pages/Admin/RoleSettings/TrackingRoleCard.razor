@using Apollo.Web.Client.Contracts
@inject IRoleSettingsClient Client
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<Strings> L

@*
    The tracking role of one platform (#33, scope §5.1.1): single select of the roles that exist, live preview of who
    would be tracked, and a confirmation that names the effect before saving.
*@
<SectionCard Title="@L["Settings_Tracking_Title"]">
    <MudSelect T="Guid?" Value="_selected" ValueChanged="SelectAsync" Label="@L["Settings_Tracking_Label"]"
               ToStringFunc="Display" FullWidth="true" Variant="Variant.Outlined" Dense="true" Class="apollo-tracking-select">
        @if (Settings.TrackingRoleId is not null)
        {
            <MudSelectItem T="Guid?" Value="@((Guid?)null)">@L["Settings_Tracking_None"]</MudSelectItem>
        }
        @foreach (var role in Settings.Roles.Where(r => !r.IsDeleted))
        {
            <MudSelectItem T="Guid?" Value="@((Guid?)role.Id)"><RoleLabel Role="role" /></MudSelectItem>
        }
    </MudSelect>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">@L["Settings_Tracking_Help"]</MudText>

    @if (_previewFailed)
    {
        <MudText Typo="Typo.body2" Color="Color.Error" Class="apollo-tracking-preview-error mt-3">@L["Settings_PreviewFailed"]</MudText>
    }
    else if (_preview is not null)
    {
        <MudText Typo="Typo.subtitle1" Class="apollo-tracking-preview mt-3">@PreviewText(_preview)</MudText>
    }

    @if (Settings.BotPermissions.IsOk)
    {
        <MudText Typo="Typo.body2" Class="apollo-settings-bot-ok mud-text-secondary mt-1">@BotOkText</MudText>
    }

    <div class="d-flex flex-wrap gap-2 mt-3">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!Changed || _saving || _preview is null)" OnClick="SaveAsync" Class="apollo-tracking-save">
            @L["Settings_Save"]
        </MudButton>
        <MudButton Variant="Variant.Text" Disabled="@(!Changed || _saving)" OnClick="ResetAsync">@L["Settings_Cancel"]</MudButton>
    </div>
</SectionCard>

@code {
    [Parameter, EditorRequired]
    public string Platform { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public RoleSettingsDto Settings { get; set; } = default!;

    /// <summary>Called after a save attempt, so the panel reloads settings and history.</summary>
    [Parameter]
    public EventCallback OnSaved { get; set; }

    private RoleSettingsDto? _shown;
    private Guid? _selected;
    private RolePreviewDto? _preview;
    private bool _previewFailed;
    private int _previewRequest;
    private bool _saving;

    private bool Changed => _selected != Settings.TrackingRoleId;

    private string BotOkText => Settings.Roles.FirstOrDefault(r => r.Id == Settings.TrackingRoleId && !r.IsDeleted) is { } role
        ? L["Settings_BotOk", role.Name]
        : L["Settings_BotOkWithoutRole"];

    protected override async Task OnParametersSetAsync()
    {
        // New settings (first load or after a save) reset the selection to what is stored.
        if (!ReferenceEquals(_shown, Settings))
        {
            _shown = Settings;
            await SelectAsync(Settings.TrackingRoleId);
        }
    }

    /// <summary>
    /// Selects the role and loads its preview. Until the preview is there, saving is off (the confirmation needs it);
    /// an answer for an older selection is dropped.
    /// </summary>
    private async Task SelectAsync(Guid? roleId)
    {
        _selected = roleId;
        _preview = null;
        _previewFailed = false;
        var request = ++_previewRequest;
        try
        {
            var preview = await Client.GetPreviewAsync(Platform, roleId is { } id ? [id] : [], CancellationToken.None);
            if (request == _previewRequest)
            {
                _preview = preview;
            }
        }
        catch (HttpRequestException)
        {
            if (request == _previewRequest)
            {
                _previewFailed = true;
            }
        }
    }

    private Task ResetAsync() => SelectAsync(Settings.TrackingRoleId);

    private string PreviewText(RolePreviewDto preview) =>
        _selected is null && Settings.Mode == RoleSettingsMode.Bootstrap
            ? L["Settings_Tracking_PreviewBootstrap", preview.NoLongerTracked.ToString("N0", UiCulture.Culture)]
            : L.Count(preview.Members, "Settings_Tracking_PreviewOne", "Settings_Tracking_Preview");

    private string Display(Guid? roleId)
    {
        if (roleId is null)
        {
            return Settings.TrackingRoleId is null ? string.Empty : L["Settings_Tracking_None"];
        }

        return Settings.Roles.FirstOrDefault(r => r.Id == roleId) is { } role
            ? role.IsDeleted ? L["Settings_RoleDeleted", role.Name] : role.Name
            : string.Empty;
    }

    private async Task SaveAsync()
    {
        var preview = _preview;
        if (preview is null || await ConfirmAsync(preview) != true)
        {
            return;
        }

        _saving = true;
        try
        {
            await Client.SetTrackingRoleAsync(Platform, _selected, CancellationToken.None);
            Snackbar.Add(L["Settings_Saved"], Severity.Success);
        }
        catch (RoleSettingsConflictException)
        {
            Snackbar.Add(L["Settings_Conflict"], Severity.Warning);
        }
        catch (RoleSettingsRejectedException)
        {
            Snackbar.Add(L["Settings_Rejected"], Severity.Error);
        }
        catch (HttpRequestException)
        {
            Snackbar.Add(L["Settings_SaveFailed"], Severity.Error);
            return;
        }
        finally
        {
            _saving = false;
        }

        await OnSaved.InvokeAsync();
    }

    /// <summary>Who starts and stops being tracked; clearing says that nothing is recorded anymore, for anyone.</summary>
    private Task<bool?> ConfirmAsync(RolePreviewDto preview)
    {
        if (_selected is not { } roleId)
        {
            return DialogService.ShowMessageBoxAsync(
                L["Settings_Confirm_Clear_Title"], L["Settings_Confirm_Clear"], yesText: L["Settings_Confirm_Yes"], cancelText: L["Settings_Cancel"]);
        }

        string?[] sentences =
        [
            L["Settings_Confirm_Set", Display(roleId)].Value,
            preview.NewlyTracked > 0 ? L.Count(preview.NewlyTracked, "Settings_Confirm_StartingOne", "Settings_Confirm_Starting") : null,
            preview.NoLongerTracked > 0 ? L.Count(preview.NoLongerTracked, "Settings_Confirm_StoppingOne", "Settings_Confirm_Stopping") : null,
            Settings.Mode == RoleSettingsMode.Bootstrap ? L["Settings_Confirm_Bootstrap"].Value : null, // TEMPORARY: removed by #62
        ];
        return DialogService.ShowMessageBoxAsync(
            L["Settings_Confirm_Title"], string.Join(' ', sentences.OfType<string>()), yesText: L["Settings_Confirm_Yes"], cancelText: L["Settings_Cancel"]);
    }
}
