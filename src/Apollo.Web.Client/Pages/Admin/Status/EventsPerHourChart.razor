@using ApexCharts
@using Apollo.Web.Client.Contracts
@using Apollo.Web.Client.Pages.Admin.Events
@inject IStringLocalizer<Strings> L

@* Kept apart from BotStatus.razor: ApexCharts and MudBlazor both define Color and Size. One bar per Zurich hour, stacked by table. *@
<ApexChart @ref="_chart" TItem="HourlyEventCountDto" Options="_options" Height="@ChartHeight">
    @foreach (var type in Types)
    {
        <ApexPointSeries TItem="HourlyEventCountDto" Items="Hours" Name="@DataEventText.TableLabel(L, type)" SeriesType="SeriesType.Bar"
                         XValue="h => HourLabel(h.HourStart)" YValue="h => h.CountOf(type)" />
    }
</ApexChart>

@code {
    private const int ChartHeight = 280;

    private readonly ApexChartOptions<HourlyEventCountDto> _options = ApexChartDefaults.Create<HourlyEventCountDto>();
    private ApexChart<HourlyEventCountDto>? _chart;
    private IReadOnlyList<HourlyEventCountDto>? _shown;

    /// <summary>The hours to show, oldest first (<see cref="BotStatusDto.EventsPerHour"/>).</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<HourlyEventCountDto> Hours { get; set; } = [];

    /// <summary>One series per counted table, in the order the host sends them.</summary>
    private IEnumerable<DataEventType> Types => Hours.FirstOrDefault()?.Types.Select(t => t.Type) ?? [];

    protected override void OnInitialized()
    {
        _options.Chart.Stacked = true;
        _options.PlotOptions = new PlotOptions { Bar = new PlotOptionsBar { BorderRadius = 2 } };
        _options.Xaxis.Labels.HideOverlappingLabels = true;
        _options.Xaxis.Labels.Rotate = 0;
    }

    // The chart keeps the series it was first rendered with; the hours of a refresh need an explicit update.
    protected override async Task OnParametersSetAsync()
    {
        var changed = _shown is not null && !ReferenceEquals(_shown, Hours);
        _shown = Hours;
        if (changed && _chart is not null)
        {
            await _chart.UpdateSeriesAsync(animate: false);
        }
    }

    /// <summary>The hour's start as Zurich clock time, e.g. <c>14</c>.</summary>
    private static string HourLabel(DateTimeOffset hourStart) =>
        TimeZoneInfo.ConvertTime(hourStart, UiTime.Zone).ToString("HH", UiCulture.Culture);
}
