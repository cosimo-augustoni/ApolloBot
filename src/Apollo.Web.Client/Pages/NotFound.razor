@page "/not-found"
@layout MainLayout
@inject IStringLocalizer<Strings> L

@* Shown by the Router for unknown client routes and by the host's status-code re-execution (Program.cs). *@
<PageTitle>@L["PageTitle", L["NotFound_PageName"]]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="py-6">
    <EmptyState Icon="@Icons.Material.Outlined.SearchOff" Title="@L["NotFound_Title"]" Explanation="@L["NotFound_Text"]">
        <MudButton Href="" Variant="Variant.Filled" Color="Color.Primary" Class="mt-2">@L["NotFound_Home"]</MudButton>
    </EmptyState>
</MudContainer>
