@page "/"
@inject IStringLocalizer<Strings> L

<PageTitle>@L["PageTitle", L["Home_PageName"]]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
    <MudText Typo="Typo.h1" Class="mb-2">@L["Home_Title"]</MudText>
    <MudText Typo="Typo.body1" Class="mud-text-secondary">@L["Home_Text"]</MudText>
</MudContainer>
