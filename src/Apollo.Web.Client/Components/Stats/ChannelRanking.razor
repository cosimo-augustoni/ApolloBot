@using Apollo.Web.Client.Contracts
@inject IStringLocalizer<Strings> L

@*
    The channels of a range (#37), threads rolled up into their channel (D2), sorted by voice time or by messages (the
    wireframe), voice first (#111); the other number breaks ties. A list rather than a bar chart: it carries both numbers,
    and below 600px its rows stack into labelled lines, so nothing scrolls sideways at 360px.
*@
@if (Channels.Count > 0)
{
    <div class="d-flex justify-end mb-2">
        <MudToggleGroup T="StatsMetric" Value="_sort" ValueChanged="Sort" SelectionMode="SelectionMode.SingleSelection" Size="Size.Small"
                        Color="Color.Primary" Class="apollo-channel-sort" aria-label="@L["Stats_Channel_Sort"]">
            <MudToggleItem Value="StatsMetric.VoiceHours" Text="@L["Stats_VoiceHours"]" />
            <MudToggleItem Value="StatsMetric.Messages" Text="@L["Stats_Messages"]" />
        </MudToggleGroup>
    </div>
}
<MudTable T="IndexedChannel" Items="Shown" Class="apollo-channel-ranking" Dense="true" Elevation="0" Breakpoint="Breakpoint.Xs"
          RowClass="apollo-channel-row">
    <HeaderContent>
        <MudTh>@L["Stats_Channel_Rank"]</MudTh>
        <MudTh>@L["Stats_Channel_Name"]</MudTh>
        <MudTh Style="text-align: right">@L["Stats_Messages"]</MudTh>
        <MudTh Style="text-align: right">@L["Stats_VoiceHours"]</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@L["Stats_Channel_Rank"]" Class="apollo-numeric">@context.Rank</MudTd>
        <MudTd DataLabel="@L["Stats_Channel_Name"]" Class="@(context.Channel.IsDeleted ? "mud-text-secondary" : null)">@ChannelName(context.Channel)</MudTd>
        <MudTd DataLabel="@L["Stats_Messages"]" Class="apollo-numeric" Style="text-align: right">@context.Channel.Messages.ToString("N0", UiCulture.Culture)</MudTd>
        <MudTd DataLabel="@L["Stats_VoiceHours"]" Class="apollo-numeric" Style="text-align: right">@VoiceTime(context.Channel.VoiceSeconds)</MudTd>
    </RowTemplate>
    <NoRecordsContent>
        @* A member who only reacted in the range has no channel with messages or voice time (#38). *@
        <MudText Typo="Typo.body2" Class="apollo-channel-ranking-empty mud-text-secondary">@L["Stats_Channel_None"]</MudText>
    </NoRecordsContent>
</MudTable>
@if (Channels.Count > Top)
{
    <div class="d-flex justify-center mt-2">
        <MudButton Variant="Variant.Text" Size="Size.Small" Class="apollo-channel-show-all" OnClick="() => _showAll = !_showAll">
            @(_showAll ? L["Stats_ShowLess"] : L["Stats_ShowAll"])
        </MudButton>
    </div>
}

@code {
    private bool _showAll;
    private StatsMetric _sort;
    private IReadOnlyList<ChannelActivityDto>? _sortedFrom;
    private IReadOnlyList<ChannelActivityDto> _sorted = [];

    /// <summary>The ranked channels (<see cref="ActivityStatsDto.Channels"/>), first place first.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<ChannelActivityDto> Channels { get; set; } = [];

    /// <summary>How many channels show until "Alle anzeigen" is clicked.</summary>
    [Parameter]
    public int Top { get; set; } = 10;

    /// <summary>The metric the channels are sorted by first; the toggle switches to the other one.</summary>
    [Parameter]
    public StatsMetric InitialMetric { get; set; }

    private sealed record IndexedChannel(int Rank, ChannelActivityDto Channel);

    private IEnumerable<IndexedChannel> Shown =>
        _sorted.Take(_showAll ? _sorted.Count : Top).Select((channel, i) => new IndexedChannel(i + 1, channel));

    protected override void OnInitialized() => _sort = InitialMetric;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_sortedFrom, Channels))
        {
            _sortedFrom = Channels;
            _sorted = Sorted();
        }
    }

    private void Sort(StatsMetric sort)
    {
        _sort = sort;
        _sorted = Sorted();
    }

    // OrderBy is stable, so equal channels keep the stats layer's order (by name).
    private IReadOnlyList<ChannelActivityDto> Sorted() => _sort == StatsMetric.VoiceHours
        ? [.. Channels.OrderByDescending(c => c.VoiceSeconds).ThenByDescending(c => c.Messages)]
        : [.. Channels.OrderByDescending(c => c.Messages).ThenByDescending(c => c.VoiceSeconds)];

    private string ChannelName(ChannelActivityDto channel) => (channel.Name, channel.IsDeleted) switch
    {
        (null, _) => L["Stats_Channel_Unknown"],
        (var name, true) => L["Stats_Channel_Deleted", name],
        (var name, false) => name,
    };

    private static string VoiceTime(long seconds) => seconds == 0 ? UiCulture.Placeholder : UiDuration.HoursAndMinutes(seconds);
}
