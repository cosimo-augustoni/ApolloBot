@using ApexCharts
@using Apollo.Web.Client.Contracts
@inject IStringLocalizer<Strings> L

@*
    Activity per Zurich day (#37): voice hours or messages, one at a time (wireframe), so a phone needs no second axis;
    voice first (#111).
    Kept apart from the pages: ApexCharts and MudBlazor both define Color and Size.
*@
<div class="d-flex justify-end mb-2">
    <MudToggleGroup T="StatsMetric" @bind-Value="_metric" SelectionMode="SelectionMode.SingleSelection" Size="MudBlazor.Size.Small"
                    Color="MudBlazor.Color.Primary" aria-label="@L["Stats_Activity_Metric"]">
        <MudToggleItem Value="StatsMetric.VoiceHours" Text="@L["Stats_VoiceHours"]" />
        <MudToggleItem Value="StatsMetric.Messages" Text="@L["Stats_Messages"]" />
    </MudToggleGroup>
</div>
@* @key: a new range or metric draws a new chart; the chart would otherwise keep the series it was first rendered with. *@
<ApexChart @key="(Days, _metric)" TItem="DailyActivityDto" Options="_options" Height="@ChartHeight">
    <ApexPointSeries TItem="DailyActivityDto" Items="Days" Name="@SeriesName" SeriesType="SeriesType.Area"
                     XValue="d => DayLabel(d.Date)" YValue="YValue" />
</ApexChart>

@code {
    private const int ChartHeight = 280;

    private readonly ApexChartOptions<DailyActivityDto> _options = ApexChartDefaults.Create<DailyActivityDto>();
    private StatsMetric _metric;

    /// <summary>One entry per day, oldest first (<see cref="ActivityStatsDto.Daily"/>).</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<DailyActivityDto> Days { get; set; } = [];

    /// <summary>The metric shown first; the toggle switches to the other one.</summary>
    [Parameter]
    public StatsMetric InitialMetric { get; set; }

    protected override void OnInitialized()
    {
        _metric = InitialMetric;
        _options.Stroke = new Stroke { Curve = Curve.Smooth, Width = 2 };
        _options.Xaxis.Labels.HideOverlappingLabels = true;
        _options.Xaxis.Labels.Rotate = 0;
        // About 60px per label, so the days do not overlap at 360px.
        _options.Xaxis.TickAmount = 5;
    }

    private string SeriesName => _metric == StatsMetric.Messages ? L["Stats_Messages"] : L["Stats_VoiceHours"];

    private Func<DailyActivityDto, decimal?> YValue => _metric == StatsMetric.Messages
        ? d => d.Counts.Messages
        : d => (decimal)UiDuration.Hours(d.Counts.VoiceSeconds);

    /// <summary>The day as in charts (style guide): <c>15.10.</c>.</summary>
    private static string DayLabel(DateOnly day) => day.ToString("dd.MM.", UiCulture.Culture);
}
